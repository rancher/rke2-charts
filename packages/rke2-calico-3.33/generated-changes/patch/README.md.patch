+  image: rancher/mirrored-calico-operator
+  registry: docker.io
 calicoctl:
   image: quay.io/calico/calico
 
+PRIME installations use the hardened operator and Calico component images.
+The component image tags are passed to the operator with
+`CALICO_IMAGE_TAG_OVERRIDES` when `global.prime.enabled` is true. The defaults
+match the hardened Calico v3.33.0 build:
+
+```yaml
+global:
+  prime:
+    enabled: true
+    operator:
+      image: rancher/hardened-calico-operator
+      version: v1.44.0-build20261023
+    imageTagOverrides:
+      calico: v3.33.0-build20261022
+      node: v3.33.0-build20261022
+      third-party-cni-plugins: v3.33.0-build20261022
+```
+
